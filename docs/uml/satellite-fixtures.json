{
  "about": [
    "Shared satellite-protocol fixtures (spare-device satellites S0, 2026-10-12).",
    "Each device's hello, the ready the core answers a paired one with (bot_name left out:",
    "it is the household's), a health frame and what the core keeps of it, and what the core",
    "may send it. Read by domovoi/tests/test_satellite_supports.py, satellite/tests/",
    "test_protocol_fixtures.py and (later) the Android room mode's JVM tests.",
    "Documented in docs/uml/satellite-protocol.md, 'Declared abilities'. Pairing tokens and",
    "codes here are placeholders, not secrets."
  ],
  "fixture_version": 1,
  "protocol_version": "0.1",
  "abilities": {
    "restart": {
      "unlocks": "`restart` frame; the dashboard's Restart satellite",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "code_sync": {
      "unlocks": "`upgrade` frame; the dashboard's Upgrade satellite",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "plugin_payloads": {
      "unlocks": "plugin payloads applied during a code sync; without it `upgrade` carries plugin_payloads:false",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "config": {
      "unlocks": "`set_config` frame; the dashboard's Settings tab",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "wifi": {
      "unlocks": "pi_action reassociate_wifi; wifi.* settings",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "mic_gain": {
      "unlocks": "mic_gain.* settings",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "leds": {
      "unlocks": "leds.* settings",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "display": {
      "unlocks": "`set_display` frame (also needs sat_type video); display.* settings",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "logs": {
      "unlocks": "`get_logs` frame; the dashboard's live log ring",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "wake_clips": {
      "unlocks": "`start_wake_recording` / `stop_wake_recording`",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "wake_models": {
      "unlocks": "`set_wake_word`, `wake_models_changed`",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "sounds": {
      "unlocks": "`sounds_changed`; sounds.* settings",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "voice": {
      "unlocks": "pi_action set_voice; without it the server keeps the room's voice (ready.room_voice)",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "time_sync": {
      "unlocks": "nothing pushed: the device steps its own clock from GET /v1/time after ready",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "chat_mode": {
      "unlocks": "`chat_start` / `chat_end` (needs full_duplex too)",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "announce_after_session_end": {
      "unlocks": "out-of-turn announcements (timers, reminders, intercom, broadcasts)",
      "assumed_without_supports": true,
      "hello_key": "announce_after_session_end"
    },
    "full_duplex": {
      "unlocks": "drop-in calls; chat mode with chat_mode",
      "assumed_without_supports": false,
      "hello_key": "supports_full_duplex"
    },
    "speech_pause": {
      "unlocks": "the server reads the device's speech_pause / speech_resume",
      "assumed_without_supports": false,
      "hello_key": "speech_pause"
    },
    "capture_control": {
      "unlocks": "`end_capture` (early commit; also needs speech_pause)",
      "assumed_without_supports": false,
      "hello_key": "capture_control"
    },
    "turn_progress": {
      "unlocks": "the `working` frame every 30 s while a request is still being worked out (keeps the device's reply backstop from giving up on a slow but working server)",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "dropin_ready": {
      "unlocks": "a drop-in call's start chime and the peer's audio wait for the device's `dropin_ready` (it finishes the reply announcing the call first; the core marks such a dropin_start `await_ready`)",
      "assumed_without_supports": false,
      "hello_key": "dropin_ready"
    },
    "room_audio": {
      "unlocks": "the device plays the room's synced sound from `/v1/room-audio/{satellite_id}` (1.5.0, docs/ROOM_AUDIO_PROTOCOL.md): the room's music, replies and timers go to it there",
      "assumed_without_supports": false,
      "hello_key": "room_audio"
    },
    "diagnostics": {
      "unlocks": "the `diag_request` frame (one read-only probe by name, answered by `diag_result`) and the room drawer's Diagnostics tab (1.5.0); never assumed without the hello key or `supports`",
      "assumed_without_supports": false,
      "hello_key": "diagnostics"
    },
    "support_shell": {
      "unlocks": "`support_open` / `support_input` / `support_resize` / `support_close` (an admin's support session, 1.5.0); the satellite's Open support session",
      "assumed_without_supports": false,
      "hello_key": "support_shell"
    },
    "room_display": {
      "unlocks": "the `room_display` frame (this room's music, timers and alarms, and one going off) and the `room_control` frame back; a paired room only; never assumed without `supports`",
      "assumed_without_supports": false,
      "hello_key": null
    },
    "mic_dsp": {
      "unlocks": "`set_mic_dsp` / `mic_dsp_mark` (XVF3800 DSP presets, admin only); the Settings tab's Microphone DSP block",
      "assumed_without_supports": false,
      "hello_key": "mic_dsp"
    },
    "wake_claim": {
      "unlocks": "1.5.0: the device claims each wake in a room whose `claim` is true (`wake_claim`), and takes `wake_grant`, `capture_keep` and the `claim` form of `end_capture` (one turn per wake word, domovoi/wake_claims.py)",
      "assumed_without_supports": false,
      "hello_key": null
    }
  },
  "always_sent": [
    "ready",
    "error",
    "pong",
    "transcript",
    "response_start",
    "response_end",
    "set_volume",
    "music_start",
    "music_stop"
  ],
