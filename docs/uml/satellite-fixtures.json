{
  "about": [
    "Shared satellite-protocol fixtures (spare-device satellites S0, 2026-10-12).",
    "Each device's hello, the ready the core answers a paired one with (bot_name left out:",
    "it is the household's), a health frame and what the core keeps of it, and what the core",
    "may send it. Read by domovoi/tests/test_satellite_supports.py, satellite/tests/",
    "test_protocol_fixtures.py and (later) the Android room mode's JVM tests.",
    "Documented in docs/uml/satellite-protocol.md, 'Declared abilities'. Pairing tokens and",
    "codes here are placeholders, not secrets."
  ],
  "fixture_version": 1,
  "protocol_version": "0.1",
  "abilities": {
    "restart": {
      "unlocks": "`restart` frame; the dashboard's Restart satellite",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "code_sync": {
      "unlocks": "`upgrade` frame; the dashboard's Upgrade satellite",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "plugin_payloads": {
      "unlocks": "plugin payloads applied during a code sync; without it `upgrade` carries plugin_payloads:false",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "config": {
      "unlocks": "`set_config` frame; the dashboard's Settings tab",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "wifi": {
      "unlocks": "pi_action reassociate_wifi; wifi.* settings",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "mic_gain": {
      "unlocks": "mic_gain.* settings",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "leds": {
      "unlocks": "leds.* settings",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "display": {
      "unlocks": "`set_display` frame (also needs sat_type video); display.* settings",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "logs": {
      "unlocks": "`get_logs` frame; the dashboard's live log ring",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "wake_clips": {
      "unlocks": "`start_wake_recording` / `stop_wake_recording`",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "wake_models": {
      "unlocks": "`set_wake_word`, `wake_models_changed`",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "sounds": {
      "unlocks": "`sounds_changed`; sounds.* settings",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "voice": {
      "unlocks": "pi_action set_voice",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "time_sync": {
      "unlocks": "nothing pushed: the device steps its own clock from GET /v1/time after ready",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "chat_mode": {
      "unlocks": "`chat_start` / `chat_end` (needs full_duplex too)",
      "assumed_without_supports": true,
      "hello_key": null
    },
    "announce_after_session_end": {
      "unlocks": "out-of-turn announcements (timers, reminders, intercom, broadcasts)",
      "assumed_without_supports": true,
      "hello_key": "announce_after_session_end"
    },
    "full_duplex": {
      "unlocks": "drop-in calls; chat mode with chat_mode",
      "assumed_without_supports": false,
      "hello_key": "supports_full_duplex"
    },
    "speech_pause": {
      "unlocks": "the server reads the device's speech_pause / speech_resume",
      "assumed_without_supports": false,
      "hello_key": "speech_pause"
    },
    "capture_control": {
      "unlocks": "`end_capture` (early commit; also needs speech_pause)",
      "assumed_without_supports": false,
      "hello_key": "capture_control"
    }
  },
  "always_sent": [
    "ready",
    "error",
    "pong",
    "transcript",
    "response_start",
    "response_end",
    "set_volume",
    "music_start",
    "music_stop"
  ],
  "frame_gates": {
    "restart": [
      "restart"
    ],
    "upgrade": [
      "code_sync"
    ],
    "set_config": [
      "config"
    ],
    "get_logs": [
      "logs"
    ],
    "start_wake_recording": [
      "wake_clips"
    ],
    "stop_wake_recording": [
      "wake_clips"
    ],
    "set_wake_word": [
      "wake_models"
    ],
    "wake_models_changed": [
      "wake_models"
    ],
    "sounds_changed": [
      "sounds"
    ],
    "set_display": [
      "display"
    ],
    "chat_start": [
      "chat_mode",
      "full_duplex"
    ],
    "dropin_start": [
      "full_duplex"
    ],
    "end_capture": [
      "capture_control",
      "speech_pause"
    ],
    "announcement": [
      "announce_after_session_end"
    ]
  },
  "config_section_ability": {
    "wifi": "wifi",
    "mic_gain": "mic_gain",
    "leds": "leds",
    "display": "display",
    "sounds": "sounds"
  },
