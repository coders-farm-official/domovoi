<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gradle dependency verification, scoped to the on-device assistant's
  native libraries from Maven: Gradle refuses the build if an artifact's
  SHA-256 differs from the one recorded here. Every other dependency is
  trusted as before (the regex below excludes only these groups), so this
  file changes nothing else about the build.

  Recorded 2026-10-12 from the artifacts as downloaded:
  - LiteRT-LM 0.18.0 from Google Maven (dl.google.com/android/maven2).
  - ONNX Runtime 1.28.0 (the official onnxruntime-android package, MIT)
    from Maven Central; the SHA-1s match the .sha1 files Maven Central
    publishes beside them. android/native/sherpa-onnx/ builds the speech
    library against this same AAR (same SHA-256).
  - ONNX Runtime 1.28.0 for the JVM (com.microsoft.onnxruntime:onnxruntime,
    MIT), unit tests only, recorded 2026-10-12 the same way (SHA-1s match
    Maven Central's .sha1 files; it publishes no .module for it).
  sherpa-onnx itself is not a Maven dependency: its JNI library is built
  from source, with text to speech left out, by android/native/sherpa-onnx/.
  A version bump updates the version in gradle/libs.versions.toml AND the
  hashes here, taken from the new artifacts.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com[.]google[.]ai[.]edge[.]litertlm$|com[.]microsoft[.]onnxruntime$).*$" regex="true"
                reason="Only the on-device assistant's native libraries are pinned by hash."/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="com.google.ai.edge.litertlm" name="litertlm-android" version="0.18.0">
         <artifact name="litertlm-android-0.18.0.aar">
            <sha256 value="706cbb8a87739b2818111bf3a19a78b8f7781586d10f80adf3415581fab7595f" origin="Google Maven, 2026-10-12"/>
         </artifact>
         <artifact name="litertlm-android-0.18.0.pom">
            <sha256 value="3c631cd8e04fe4289818d41675c0f6b1f26a7a37db63606699a51e2c95695a54" origin="Google Maven, 2026-10-12"/>
         </artifact>
      </component>
      <component group="com.microsoft.onnxruntime" name="onnxruntime-android" version="1.28.0">
         <artifact name="onnxruntime-android-1.28.0.aar">
            <sha256 value="f351a0638696f54b35184290dbc001d66daae17281ad0b548d2c70347d53b8a9" origin="Maven Central, 2026-10-12"/>
         </artifact>
         <artifact name="onnxruntime-android-1.28.0.pom">
            <sha256 value="0e575ec392a5ab9220924db266214459ae8912fec2427cf826c650b70f6a2947" origin="Maven Central, 2026-10-12"/>
         </artifact>
      </component>
      <component group="com.microsoft.onnxruntime" name="onnxruntime" version="1.28.0">
         <artifact name="onnxruntime-1.28.0.jar">
            <sha256 value="3a9dc00bed7ee467ded8a257f99fc216570d385f8b06053570d33e9b5d7c7a37" origin="Maven Central, 2026-10-12"/>
         </artifact>
         <artifact name="onnxruntime-1.28.0.pom">
            <sha256 value="7436b3b70d9ed328dfc181d6a2ba0bcda0c79f5a763f15e69d6715ce9ae59fe9" origin="Maven Central, 2026-10-12"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
