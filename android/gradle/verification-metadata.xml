<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gradle dependency verification, scoped to the on-device assistant's two
  native libraries: Gradle refuses the build if either artifact's SHA-256
  differs from the one recorded here. Every other dependency is trusted as
  before (the regex below excludes only these two groups), so this file
  changes nothing else about the build.

  Recorded 2026-10-12 from the artifacts as downloaded:
  - LiteRT-LM 0.18.0 from Google Maven (dl.google.com/android/maven2).
  - sherpa-onnx 1.13.8 from github.com/k2-fsa/sherpa-onnx/releases/tag/v1.13.8;
    the hash matches the digest GitHub lists for that release asset.
  A version bump updates the version in gradle/libs.versions.toml AND the
  hashes here, taken from the new artifacts.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com[.]google[.]ai[.]edge[.]litertlm$|com[.]k2fsa[.]sherpa[.]onnx$).*$" regex="true"
                reason="Only the on-device assistant's native libraries are pinned by hash."/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="com.google.ai.edge.litertlm" name="litertlm-android" version="0.18.0">
         <artifact name="litertlm-android-0.18.0.aar">
            <sha256 value="706cbb8a87739b2818111bf3a19a78b8f7781586d10f80adf3415581fab7595f" origin="Google Maven, 2026-10-12"/>
         </artifact>
         <artifact name="litertlm-android-0.18.0.pom">
            <sha256 value="3c631cd8e04fe4289818d41675c0f6b1f26a7a37db63606699a51e2c95695a54" origin="Google Maven, 2026-10-12"/>
         </artifact>
      </component>
      <component group="com.k2fsa.sherpa.onnx" name="sherpa-onnx" version="1.13.8">
         <artifact name="sherpa-onnx-1.13.8.aar">
            <sha256 value="633c24321e06b1fe79feafa03ea16cbc0f8a286641e2da3559bac91bdb13bd96" origin="GitHub release v1.13.8, 2026-10-12"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
