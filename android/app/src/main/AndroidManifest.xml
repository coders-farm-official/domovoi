<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Save-to-device downloads land in shared Downloads via DownloadManager;
         only API 26–28 still need this to write there. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Offline/local mode: the Music + Video tabs read on-device media via
         MediaStore when no domovoi is connected (and pick up files saved by
         the download actions), and the Files tab lists the phone's photos.
         Granular media permissions on API 33+, the legacy read permission
         below. Folders in the Files tab come through the system folder
         picker (a per-folder grant), never an all-files permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The on-device assistant's model download (assistant/ModelDownloadWorker)
         runs as a WorkManager foreground job so it survives leaving the app;
         Android 14+ needs its service type declared and permitted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Room mode (roommode/): a spare phone as a room satellite. Its
         foreground service listens with the screen off (type microphone,
         Android 14+ needs the permission named) and speaks (mediaPlayback,
         above); a Wi-Fi lock keeps its socket up; the Wi-Fi link speed and
         signal go into its health sample; the camera reads the room code
         (asked for only when "Scan" is pressed, and never required to
         install). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Timer and reminder alerts (alerts/): a local alarm per running timer
         so the phone rings on time with the app closed. Exact alarms need
         SCHEDULE_EXACT_ALARM on API 31-32 (user-revocable; inexact without
         it) and USE_EXACT_ALARM from API 33 (granted at install; fine for
         this sideloaded app, a restriction for a future Play listing).
         RECEIVE_BOOT_COMPLETED re-arms them after a reboot. The background
         sync's tick (alerts/TimerSync.kt) is an exact alarm under the same
         permissions: only an exact allow-while-idle alarm gets the network
         in Doze. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The on-device assistant speaks with the phone's text-to-speech
         engine (assistant/AndroidSpeechOut); from API 30 an app sees the
         installed engines only when it declares that it looks for them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- allowBackup=false: nothing the app stores (server address, device id,
         the pairing token, the timer alerts' mirror with a reminder's words)
         is ever copied into a cloud or adb backup. From API 31 that flag no
         longer stops a device-to-device transfer, so dataExtractionRules
         excludes every domain from both (res/xml/data_extraction_rules.xml);
         fullBackupContent says the same to API 26-30. networkSecurityConfig
         scopes cleartext to the home network; see
         res/xml/network_security_config.xml.
         enableOnBackInvokedCallback: predictive back, the default once the
         app targets API 36 on Android 16, opted into from Android 13 too, so
         back behaves the same on every version: the app handles back only
         through BackHandler / OnBackPressedDispatcher, never onBackPressed()
         or KEYCODE_BACK (TargetApi36Test checks). -->
    <application
        android:name=".DomovoiApplication"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="domovoi"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Domovoi">

        <!-- The on-device assistant's GPU backend (LiteRT-LM) opens the
             vendor's OpenCL driver; from API 31 an app sees a vendor
             library only when it asks for it here. required="false": a
             phone without them still installs and runs on the CPU. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Room mode (roommode/): its own task, its own launcher icon
             ("Domovoi Room", the alias below), a consent screen first, then
             the dark full-screen room display. The setup screen also takes
             a domovoi-room: link (the room code a camera app read): it only
             fills the form, nothing happens until the person confirms. -->
        <activity
            android:name=".roommode.RoomSetupActivity"
            android:exported="true"
            android:label="Domovoi Room"
            android:taskAffinity="com.domovoi.app.room"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="domovoi-room" />
            </intent-filter>
        </activity>
        <activity
            android:name=".roommode.RoomModeActivity"
            android:exported="false"
            android:label="Domovoi Room"
            android:taskAffinity="com.domovoi.app.room"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity-alias
            android:name=".RoomLauncher"
            android:targetActivity=".roommode.RoomSetupActivity"
            android:exported="true"
            android:label="Domovoi Room"
            android:icon="@mipmap/ic_launcher_room">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <service
            android:name=".roommode.RoomService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
        <!-- After a reboot a room that was listening posts "tap to resume":
             Android starts no microphone service from the boot broadcast. -->
        <receiver
            android:name=".roommode.RoomBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Not exported: only this app's own immutable PendingIntents (a
             timer's alarm, the background sync's tick) and protected system
             broadcasts (boot, app update) reach them. -->
        <receiver
            android:name=".alerts.TimerAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".alerts.TimerSyncReceiver"
            android:exported="false" />
        <receiver
            android:name=".alerts.TimerBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager's own foreground service, given the type the model
             download runs under (merged into the library's declaration). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
