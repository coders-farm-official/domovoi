# The phonemizer's data and golden fixture are checked byte for byte (their
# SHA-256 are pinned in data/SHA256SUMS and golden.json), so no line-ending
# conversion on checkout, whatever core.autocrlf says.
domovoi/phonemizer/data/** -text
domovoi/phonemizer/golden.json -text
domovoi/voice_clips/** -text
# The tag-reader corpus: real audio files and the answers recorded for
# them, compared byte for byte.
domovoi/tests/fixtures/media_tags/** -text
# The speaker-encoder fixtures: 16 kHz excerpts and the embeddings recorded for them.
domovoi/tests/fixtures/speaker_encoder/** -text
android/licences/** -text
