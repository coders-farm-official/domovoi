 "init_eqs_eel": "",
 "frame_eqs_eel": "wave_r = 0.2 + 0.2*sin(time*0.3);\nwave_g = 0.6 + 0.3*sin(time*0.41);\nwave_b = 0.9;\nwave_y = 0.5 + 0.25*sin(time*0.23);\nq1 = 0.003 + 0.004*bass_att;\nq2 = 0.003 + 0.004*treb_att;\nq3 = time;",
