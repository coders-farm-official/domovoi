 "init_eqs_eel": "",
 "frame_eqs_eel": "wave_r = 1.0;\nwave_g = 0.55 + 0.2*sin(time*0.7);\nwave_b = 0.12 + 0.1*sin(time*0.37);\nwave_a = 0.55 + 0.25*min(bass_att, 2);\nzoom = 1.008 + 0.035*bass_att;\nrot = 0.006*sin(time*0.31);\nq1 = treb_att;",
