 "init_eqs_eel": "",
 "frame_eqs_eel": "wave_r = 0.5 + 0.5*sin(time*0.83);\nwave_g = 0.5 + 0.5*sin(time*0.61 + 1.7);\nwave_b = 0.5 + 0.5*sin(time*0.47 + 3.9);\nwave_x = 0.5 + 0.3*sin(time*0.37);\nwave_y = 0.5 + 0.3*cos(time*0.29);\nzoom = 0.99 + 0.03*bass_att;\nrot = 0.02*sin(time*0.17);",
 "pixel_eqs_eel": "",
 "warp": "",
 "comp": "shader_body {\n  vec2 d = (uv - 0.5) * vec2(aspect.x, 1.0) / aspect.x;\n  float r = length(d);\n  float a = atan(d.y, d.x) + time * 0.05;\n  float seg = 6.2831853 / 6.0;\n  a = mod(a, seg);\n  a = abs(a - seg * 0.5);\n  vec2 k = 0.5 + r * vec2(cos(a), sin(a));\n  vec3 base = texture(sampler_main, k).rgb;\n  vec3 glow = texture(sampler_blur1, k).rgb * scale1 + bias1;\n  ret = base * 1.25 + glow * 0.7;\n  ret = ret / (1.0 + ret * 0.3);\n}"
