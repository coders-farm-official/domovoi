 "init_eqs_eel": "",
 "frame_eqs_eel": "zoom = 0.965 - 0.03*bass_att;\nib_r = 0.9; ib_g = 0.5 + 0.2*sin(time*0.5); ib_b = 0.25 + 0.2*sin(time*0.3);\nib_a = 0.03 + 0.12*min(bass, 2)/2;\nib_size = 0.004 + 0.008*min(bass_att, 2)/2;\nwave_r = 0.3; wave_g = 0.8; wave_b = 1;\nrot = 0.01*sin(time*0.4);",
