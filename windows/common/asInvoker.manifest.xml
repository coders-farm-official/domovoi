<?xml version="1.0" encoding="utf-8"?>
<!-- Embedded in DomovoiHost.exe and DomovoiSetupHelper.exe. asInvoker:
     never elevate on their own (Windows' installer detection would
     otherwise ask for elevation for any exe with "Setup" in its name). The
     helper runs elevated only as the child of Setup or Uninstall. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
