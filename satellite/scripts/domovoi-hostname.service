# Domovoi satellite: the host name domovoi-<room>, set BEFORE the network
# starts. The router learns a satellite's name from its DHCP request, which
# NetworkManager sends as soon as the Wi-Fi joins, with whatever name the
# unit has at that moment; renamed later in the boot, a satellite kept its
# old name on the router until it next reconnected. This oneshot runs the
# host-name part of satellite/net_settings.py (--before-network: no
# NetworkManager, no unit restarts, never a failure that matters) and
# NetworkManager waits for it. The rest of the network step still runs from
# domovoi-provisioning.service, which folds this run's record into its own.
#
# Root on purpose: it writes /etc/hostname and /etc/hosts. It starts from
# the satellite account's venv and code tree, like
# domovoi-provisioning.service: docs/SECURITY_PRIVACY.md names both as the
# root-runs-updatable-code path the owner accepted for the network
# settings.
#
# Installed by stage 1 on a new card; on an older one the boot step
# (net_settings.ensure_early_unit) renders this file with @HOME@ and
# enables it, so it runs from the boot after the upgrade's first. Manual
# form:
#   sudo sed -e "s|@HOME@|$HOME|g" \
#     ~/domovoi/satellite/scripts/domovoi-hostname.service \
#     | sudo tee /etc/systemd/system/domovoi-hostname.service >/dev/null
#   sudo systemctl enable domovoi-hostname

[Unit]
Description=Domovoi satellite host name, set before the network starts
After=local-fs.target
Before=network-pre.target NetworkManager.service dhcpcd.service domovoi-provisioning.service
Wants=network-pre.target
ConditionPathExists=@HOME@/.domovoi/config.toml

[Service]
Type=oneshot
User=root
Environment=HOME=@HOME@
WorkingDirectory=@HOME@/domovoi
ExecStart=@HOME@/satellite-venv/bin/python -m satellite.net_settings --before-network
# NetworkManager waits for this; it must never hold the network up long.
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
