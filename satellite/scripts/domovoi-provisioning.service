# Domovoi satellite USB-adoption mode. Runs BEFORE the satellite client.
# On every provisioned boot it checks the network settings in
# satellite/net_settings.py (no setup hotspot profile, Wi-Fi power saving
# off, host name domovoi-<room>), applies whichever is missing, records
# what it changed in ~/.domovoi/net-settings.json, and exits 0. On an
# UNPROVISIONED boot it owns the box: exposes the DOMOVOI-SET gadget
# volume (or the setup portal) and waits for the adopt flow (see
# satellite/provisioning_mode.py).
#
# Root on purpose: configfs gadget composition, mkfs.vfat, nmcli,
# timedatectl, and the post-provision reboot all need it. Not sandboxed:
# it edits /etc/wpa_supplicant, /boot/firmware and /sys/kernel/config, the
# very places a sandbox would close. It starts from the satellite
# account's venv and code tree, which docs/SECURITY_PRIVACY.md names as
# the remaining root-runs-user-editable-code path.
#
# Install (the media-prep pipeline does this; manual form):
#   sudo sed -e "s|@USER@|$USER|g" -e "s|@HOME@|$HOME|g" \
#     ~/domovoi/satellite/scripts/domovoi-provisioning.service \
#     | sudo tee /etc/systemd/system/domovoi-provisioning.service >/dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable domovoi-provisioning

[Unit]
Description=Domovoi satellite USB adoption mode
Before=domovoi-satellite.service
After=local-fs.target

[Service]
Type=simple
User=root
Environment=HOME=@HOME@
ExecStart=@HOME@/satellite-venv/bin/python -m satellite.provisioning_mode
WorkingDirectory=@HOME@/domovoi
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
