# Domovoi satellite USB-adoption mode. Runs BEFORE the satellite client.
# On every provisioned boot it checks the network settings in
# satellite/net_settings.py (no setup hotspot profile, Wi-Fi power saving
# off, host name domovoi-<room>), applies whichever is missing, records
# what it changed in /var/lib/domovoi/net-settings.json, and exits 0. On an
# UNPROVISIONED boot it owns the box: exposes the DOMOVOI-SET gadget
# volume (or the setup portal) and waits for the adopt flow (see
# satellite/provisioning_mode.py).
#
# Root on purpose: configfs gadget composition, mkfs.vfat, nmcli,
# timedatectl, and the post-provision reboot all need it. Not sandboxed:
# it edits /etc/wpa_supplicant, /boot/firmware and /sys/kernel/config, the
# very places a sandbox would close.
#
# It runs ROOT'S OWN COPY of the code (since 1.5.0): the system Python,
# from /usr/local/lib/domovoi/root-code (root's, writable by nobody else;
# satellite/root_code.py), never the service account's venv or ~/domovoi
# tree. It names the account, never a path in its home. At every boot root
# first brings its copy up to the code the client synced, after checking
# the server's signature on it against the root-owned pin
# (satellite/root_entry.py). A card prepared before 1.5.0 switches to this
# unit by itself at a boot after the satellite update.
#
# Install (the media-prep pipeline does this): stage 1 installs root's copy
# from the card and renders @USER@. On a hand-built satellite, from the
# checkout's root, as root:
#   sudo /usr/bin/python3 -E -s -m satellite.root_code switch "$USER"
# which installs root's copy, the XVF3800 wrapper and this unit, then
#   sudo systemctl enable domovoi-provisioning

[Unit]
Description=Domovoi satellite USB adoption mode
Before=domovoi-satellite.service
After=local-fs.target

[Service]
Type=simple
User=root
Environment=DOMOVOI_SATELLITE_USER=@USER@
WorkingDirectory=/usr/local/lib/domovoi/root-code
ExecStart=/usr/bin/python3 -E -s -m satellite.root_entry
Restart=on-failure
RestartSec=5
# Exit 3: setup can never start on this card (provisioning_mode
# EXIT_CANNOT_SET_UP: the setup network's packages are missing). The ring is
# red and the card's device-info.json says why; restarting changes nothing.
RestartPreventExitStatus=3

[Install]
WantedBy=multi-user.target
