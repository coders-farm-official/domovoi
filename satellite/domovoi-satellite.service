# Domovoi voice satellite — the systemd unit, now IN the repo (it rides the
# satellite-code sync channel like every other satellite file) instead of
# living as a heredoc in PROVISIONING.md. @USER@/@HOME@ are placeholders:
# render with scripts/install-service.sh, or by hand:
#
#   sudo sed -e "s|@USER@|$USER|g" -e "s|@HOME@|$HOME|g" \
#     ~/domovoi/satellite/domovoi-satellite.service \
#     | sudo tee /etc/systemd/system/domovoi-satellite.service >/dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable --now domovoi-satellite
#
# Self-restart needs the sudoers entry from PROVISIONING.md §8.1.

[Unit]
Description=Domovoi voice satellite
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/domovoi
ExecStart=@HOME@/satellite-venv/bin/python -m satellite.client
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# The file system is read-only to this unit except the trees the client
# writes: its config dir, the code tree the server syncs, and /tmp (wpa_cli
# creates its control socket there, and the supplicant answers on that
# path, so it cannot be a private one). NoNewPrivileges is deliberately
# NOT set, and nothing that implies it is: the sudoers.d helpers are how
# the client restarts itself, re-joins Wi-Fi and applies plugin payloads,
# and sudo has to gain privileges to do that. A sudo'd child inherits this
# read-only view; the helpers that need more (domovoi-apply-payload) run
# themselves as a transient unit outside it. See docs/SECURITY_PRIVACY.md,
# "The satellite service account".
ProtectSystem=strict
ReadWritePaths=@HOME@/.domovoi @HOME@/domovoi /tmp

[Install]
WantedBy=multi-user.target
