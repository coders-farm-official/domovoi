# ── Database ────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ltldb
SPRING_DATASOURCE_USERNAME=ltluser
SPRING_DATASOURCE_PASSWORD=

# ── Stytch (auth) ───────────────────────────────────────────────────────
STYTCH_PROJECT_ID=
STYTCH_PROJECT_SECRET=
STYTCH_PUBLIC_TOKEN=

# ── Stripe (billing) ────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to run against the built-in fake billing
# provider: checkout, webhooks, entitlements and grace periods all work
# end to end with no Stripe account.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── App ─────────────────────────────────────────────────────────────────
APP_BASE_URL=https://lazythumblabs.com
APP_SECURE_COOKIES=true
SERVER_PORT=8080

# ── Relay tuning (optional; defaults in application.properties) ─────────
# LTL_RELAY_HEARTBEAT_SECONDS=30
# LTL_RELAY_USAGE_FLUSH_SECONDS=30
# LTL_ENROLLMENT_TTL_MINUTES=15
# LTL_ENROLLMENT_MAX_PER_IP_PER_HOUR=20
# LTL_BILLING_GRACE_DAYS=7

# NOTE: never commit a filled-in copy of this file. Secrets belong in the
# deployment environment; a real key checked into git is a key that has
# to be rotated.
