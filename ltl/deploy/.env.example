# Copy to .env and fill in before `docker compose up -d`.

# The domain Caddy will get a certificate for.
LTL_DOMAIN=lazythumblabs.com
APP_BASE_URL=https://lazythumblabs.com

# Postgres. Generate with: openssl rand -base64 32
POSTGRES_DB=ltldb
POSTGRES_USER=ltluser
POSTGRES_PASSWORD=

# Stytch (auth). Without these, nobody can sign in.
STYTCH_PROJECT_ID=
STYTCH_PROJECT_SECRET=
STYTCH_PUBLIC_TOKEN=

# Stripe (billing). Leave empty to run against the built-in fake
# provider — useful for a staging box, never for production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
