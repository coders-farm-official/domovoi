#!/bin/bash
# Domovoi satellite — STAGE 1 first-boot bootstrap (runs as root, OFFLINE,
# via the kernel-cmdline systemd.run hook the media-prep overlay installed;
# the same mechanism Raspberry Pi Imager uses for its firstrun.sh).
#
# Everything needed is in the payload on this boot partition — no network.
# Every step drops a marker under /var/lib/domovoi/bootstrap-steps/ so a
# power-cut boot re-runs idempotently. Progress/errors surface in
# device-info.json on this partition (readable over the adoption gadget
# and by pulling the card).
#
# Rendered by domovoi/satellite_media/overlay.py — placeholders:
#   @SAT_USER@      the account to create/use
#   @MIC_PROFILE@   respeaker_2mic_hat_v1|_v2 | xvf3800_usb | none
#   @SAT_TYPE@      voice | video
#   @SETUP_TRANSPORT@  usb | portal  (how this unit is adopted)
#   @WIFI_COUNTRY@  ISO 3166-1 alpha-2 wireless regulatory domain
#   @KEYBOARD_LAYOUT@  two-letter X11 console keyboard layout

set -u
# This script lives at <boot>/domovoi/firstrun.sh, but every path below is
# relative to the boot partition ROOT ($BOOT/domovoi/payload.tar.gz,
# $BOOT/config.txt, $BOOT/overlays/). So BOOT is the script's PARENT.
#
# Getting this wrong is silent and total: step 0 cd's into a directory that
# doesn't exist, fail() exits 1, and because systemd.run_success_action only
# reboots on SUCCESS the device sits in an empty target with a blank screen
# and no stage 1 at all. Confirmed on hardware 2026-09-08.
BOOT="$(cd "$(dirname "$0")/.." && pwd)"
STEPS=/var/lib/domovoi/bootstrap-steps
PAYDIR=/opt/domovoi-payload
SAT_USER="@SAT_USER@"
MIC_PROFILE="@MIC_PROFILE@"
SAT_TYPE="@SAT_TYPE@"
SETUP_TRANSPORT="@SETUP_TRANSPORT@"
WIFI_COUNTRY="@WIFI_COUNTRY@"
KEYBOARD_LAYOUT="@KEYBOARD_LAYOUT@"
LOG=/var/log/domovoi-firstrun.log

mkdir -p "$STEPS"
exec >>"$LOG" 2>&1
echo "== domovoi stage-1 $(date -Is) =="

info() {
  # Update device-info.json (status/step/error) on the boot partition.
  python3 - "$BOOT/domovoi/device-info.json" "$1" "$2" "${3:-}" <<'EOF' || true
import json, sys
p, status, step, error = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] or None
try:
    doc = json.load(open(p))
except Exception:
    doc = {"domovoi_setup": 1, "nonce": "firstboot", "profiles_supported": []}
doc.update(status=status, step=step, error=error)
json.dump(doc, open(p, "w"), indent=2)
EOF
}

fail() { echo "FAIL: $1"; info bootstrapping "$2" "$1"; exit 1; }
done_step() { touch "$STEPS/$1"; }
skip() { [ -f "$STEPS/$1" ]; }

# Packages with no aarch64 wheel, which pip therefore has to BUILD. Left in
# the requirements file, one of them fails the whole transaction and takes
# every other package down with it — numpy included, even with its wheel
# sitting right there in the payload. The wheel FETCHER already sidesteps
# exactly this (fetchers.py SDIST_ONLY_PACKAGES); the install paths never
# got told. Strip them out, install the rest, then attempt them on their own
# where failing costs only the LEDs.
SDIST_ONLY="@SDIST_ONLY@"
REQ_CORE=/tmp/domovoi-req-core.txt
strip_sdist_only() {
  cp "$1" "$REQ_CORE"
  for PKG in $SDIST_ONLY; do
    # Name followed by a version specifier, an extra, or end of line —
    # never a package that merely starts with the same letters.
    grep -viE "^${PKG}([^A-Za-z0-9_-]|\$)" "$REQ_CORE" >"$REQ_CORE.new" || true
    mv "$REQ_CORE.new" "$REQ_CORE"
  done
}


info bootstrapping stage1-start

# 0. Payload integrity (power-loss-during-copy guard).
if ! skip verify; then
  info bootstrapping verify-payload
  (cd "$BOOT/domovoi" && sha256sum -c payload.sha256) \
    || fail "payload checksum mismatch — re-run prepare media" verify-payload
  done_step verify
fi

# 1. Extract.
if ! skip extract; then
  info bootstrapping extract
  mkdir -p "$PAYDIR"
  tar -xzf "$BOOT/domovoi/payload.tar.gz" -C "$PAYDIR" --strip-components=1 \
    || fail "payload extract failed" extract
  done_step extract
fi

# 2. User (locked password; SSH stays whatever the stock image chose).
if ! skip user; then
  info bootstrapping create-user
  id "$SAT_USER" >/dev/null 2>&1 || useradd -m -s /bin/bash "$SAT_USER"
  # `sudo` matters: this is also the console account media prep hands the
  # operator (userconf.txt), and without it there is NO route to root on the
  # device at all — the root account is locked on Pi OS and the
  # sudoers.d/domovoi-satellite file grants three specific commands only.
  # A unit you cannot get a shell on is a unit you cannot support.
  usermod -aG sudo,audio,video,plugdev,gpio,spi,i2c "$SAT_USER" 2>/dev/null || true
  done_step user
fi
HOME_DIR="$(getent passwd "$SAT_USER" | cut -d: -f6)"

# 3. Debs (offline cache; ordering handled by a double pass).
if ! skip debs; then
  info bootstrapping install-debs
  if ls "$PAYDIR"/debs/*.deb >/dev/null 2>&1; then
    # Install only what this image LACKS. The cache is resolved against a
    # plain Debian of the same release, but Pi OS ships its own builds of
    # some of these (alsa-utils 1.2.14-1+rpt1 vs Debian's 1.2.14-1), and
    # dpkg -i on the lot happily downgrades them — which is what produced
    # "dpkg: warning: downgrading ..." and then a half-configured system.
    # The payload is here to fill gaps, not to overwrite the distribution.
    TO_INSTALL=""
    for D in "$PAYDIR"/debs/*.deb; do
      P="$(dpkg-deb -f "$D" Package 2>/dev/null)" || continue
      NEWV="$(dpkg-deb -f "$D" Version 2>/dev/null)" || continue
      CURV="$(dpkg-query -W -f='${Version}' "$P" 2>/dev/null || true)"
      if [ -n "$CURV" ] && dpkg --compare-versions "$CURV" ge "$NEWV"; then
        continue
      fi
      TO_INSTALL="$TO_INSTALL $D"
    done
    if [ -n "$TO_INSTALL" ]; then
      # Twice: the cache is unordered, so a package whose dependency sorts
      # later fails the first pass and succeeds the second.
      dpkg -i --force-confold $TO_INSTALL >/dev/null 2>&1 || \
      dpkg -i --force-confold $TO_INSTALL || \
        echo "WARN: some debs failed — stage 2 repairs via apt online"
    else
      echo "all cached debs already present at this version or newer"
    fi
  else
    echo "WARN: no deb cache in payload — stage 2 installs via apt online"
  fi
  done_step debs
fi

# 4. Python venv, pip bootstrapped FROM THE SHIPPED WHEELS (no ensurepip,
#    no network): create --without-pip, then install pip from the cache.
if ! skip venv; then
  info bootstrapping python-venv
  PYV_OK=1
  python3 -m venv --without-pip "$HOME_DIR/satellite-venv" || PYV_OK=0
  if [ "$PYV_OK" = 1 ] && ls "$PAYDIR"/wheels/pip-*.whl >/dev/null 2>&1; then
    PIP_WHEEL="$(ls "$PAYDIR"/wheels/pip-*.whl | head -1)"
    "$HOME_DIR/satellite-venv/bin/python" "$PIP_WHEEL/pip" install \
        --no-index --find-links "$PAYDIR/wheels" pip setuptools wheel \
      || PYV_OK=0
    if [ "$PYV_OK" = 1 ]; then
      strip_sdist_only "$PAYDIR/satellite/requirements.txt"
      "$HOME_DIR/satellite-venv/bin/pip" install --no-index \
          --find-links "$PAYDIR/wheels" -r "$REQ_CORE" \
        || echo "WARN: offline requirements install incomplete — stage 2 retries online"
      for PKG in $SDIST_ONLY; do
        "$HOME_DIR/satellite-venv/bin/pip" install --no-index \
            --find-links "$PAYDIR/wheels" "$PKG" \
          || echo "WARN: $PKG unavailable offline (LED indicators stay dark)"
      done
      "$HOME_DIR/satellite-venv/bin/pip" install --no-index --no-deps \
          --find-links "$PAYDIR/wheels" openwakeword \
        || echo "WARN: openwakeword offline install failed — stage 2 retries"
    fi
  fi
  [ "$PYV_OK" = 1 ] || fail "python venv bootstrap failed" python-venv
  done_step venv
fi

# 5. Code + assets into place.
if ! skip code; then
  info bootstrapping copy-code
  mkdir -p "$HOME_DIR/domovoi"
  cp -r "$PAYDIR/satellite" "$HOME_DIR/domovoi/"
  cp "$PAYDIR/pyproject.toml" "$HOME_DIR/domovoi/" 2>/dev/null || true
  mkdir -p "$HOME_DIR/.domovoi"
  [ -d "$PAYDIR/oww_models" ] && cp -r "$PAYDIR/oww_models" "$HOME_DIR/.domovoi/" || true
  [ -d "$PAYDIR/sounds" ] && cp -r "$PAYDIR/sounds" "$HOME_DIR/.domovoi/" || true
  [ -d "$PAYDIR/wake_models" ] && cp -r "$PAYDIR/wake_models" "$HOME_DIR/.domovoi/" || true
  [ -d "$PAYDIR/plugins" ] && cp -r "$PAYDIR/plugins" "$HOME_DIR/.domovoi/plugin_payloads" || true
  [ -d "$PAYDIR/debs" ] && cp -r "$PAYDIR/debs" "$HOME_DIR/.domovoi/deb_cache" || true
  [ "$SAT_TYPE" = "video" ] && echo video >"$HOME_DIR/.domovoi/image_sat_type" || true
  # The mic board is decided at prepare time; provisioning mode needs it
  # to fill device_profile without asking the customer.
  printf '%s\n' "$MIC_PROFILE" >"$HOME_DIR/.domovoi/image_device_profile"
  # Setup-AP credentials for the portal transport. Presence of this
  # file is what selects the portal over the USB gadget at boot 2.
  if [ -f "$BOOT/domovoi/ap.json" ]; then
    cp "$BOOT/domovoi/ap.json" "$HOME_DIR/.domovoi/ap.json"
    chmod 600 "$HOME_DIR/.domovoi/ap.json"
  fi
  chown -R "$SAT_USER:$SAT_USER" "$HOME_DIR/domovoi" "$HOME_DIR/.domovoi" "$HOME_DIR/satellite-venv"
  done_step code
fi

# 5a. Wireless regulatory domain.
#
#     Stock Pi OS soft-blocks the radio via rfkill until a country is set —
#     the regulatory domain decides legal channels and power, so the driver
#     refuses to transmit without one. Imager normally sets this and we tell
#     people to skip Imager's pre-configuration, so nothing did. On a portal
#     unit a blocked radio is terminal: no setup AP, no way to onboard it at
#     all, ever.
if ! skip wificountry; then
  info bootstrapping wifi-country
  if command -v raspi-config >/dev/null 2>&1; then
    raspi-config nonint do_wifi_country "$WIFI_COUNTRY" || \
      echo "WARN: could not set wifi country $WIFI_COUNTRY"
  else
    # Non-Pi boards (Radxa) have no raspi-config; set the domain directly.
    iw reg set "$WIFI_COUNTRY" 2>/dev/null || \
      echo "WARN: no raspi-config and iw reg set failed"
  fi
  rfkill unblock wifi 2>/dev/null || true
  done_step wificountry
fi

# 5ab. Console keyboard layout.
#
#      Pi OS ships XKBLAYOUT="gb". Every symbol a US keyboard prints is
#      then somewhere else, and | in particular becomes unreachable — which
#      matters because the only time anyone plugs a keyboard into one of
#      these is when it has gone wrong and they want to pipe a log into
#      grep.
if ! skip keyboard; then
  info bootstrapping keyboard
  if [ -f /etc/default/keyboard ]; then
    sed -i "s/^XKBLAYOUT=.*/XKBLAYOUT=\"$KEYBOARD_LAYOUT\"/" /etc/default/keyboard
  else
    printf 'XKBMODEL="pc105"\nXKBLAYOUT="%s"\nXKBVARIANT=""\nXKBOPTIONS=""\n' \
      "$KEYBOARD_LAYOUT" >/etc/default/keyboard
  fi
  # Regenerate the console keymap from that file. Best-effort: a unit with
  # the wrong layout is inconvenient, not broken, and must still boot.
  setupcon --save-only 2>/dev/null || \
    echo "WARN: could not apply keyboard layout $KEYBOARD_LAYOUT"
  done_step keyboard
fi

# 5b. Setup-portal DNS. NetworkManager's shared mode runs its own dnsmasq;
#     without a catch-all the captive-portal probes resolve nowhere and the
#     sign-in page never opens by itself.
if [ "$SETUP_TRANSPORT" = "portal" ] && ! skip portaldns; then
  info bootstrapping portal-dns
  mkdir -p /etc/NetworkManager/dnsmasq-shared.d
  cat >/etc/NetworkManager/dnsmasq-shared.d/domovoi-portal.conf <<'EOF'
# Domovoi setup portal — every name resolves to us so the captive check
# fails deliberately and the phone opens the sign-in page.
address=/#/192.168.4.1
dhcp-option=6,192.168.4.1
# RFC 8910: tell the client the captive-portal URL EXPLICITLY over DHCP
# rather than relying on it noticing that its probe was hijacked. Supported
# by Android 11+ and iOS 14+, and far more dependable than probe
# interception, which private DNS and cached per-SSID verdicts both defeat.
dhcp-option=114,http://192.168.4.1/
EOF
  done_step portaldns
fi

# 6. Mic-board overlay (prebuilt dtbo from the payload when present).
if ! skip micboard; then
  info bootstrapping mic-board
  case "$MIC_PROFILE" in
    respeaker_2mic_hat_v1|respeaker_2mic_hat_v2)
      if ls "$PAYDIR"/dtbo/*.dtbo >/dev/null 2>&1; then
        cp "$PAYDIR"/dtbo/*.dtbo "$BOOT/overlays/" 2>/dev/null \
          || cp "$PAYDIR"/dtbo/*.dtbo /boot/firmware/overlays/ 2>/dev/null || true
        grep -q "^dtoverlay=respeaker" "$BOOT/config.txt" 2>/dev/null || \
          printf '\ndtoverlay=%s\ndtparam=spi=on\n' \
            "$(basename "$(ls "$PAYDIR"/dtbo/*.dtbo | head -1)" .dtbo)" >>"$BOOT/config.txt"
      else
        echo "WARN: no prebuilt dtbo in payload — follow PROVISIONING §4 on-device"
      fi
      ;;
    xvf3800_usb|none) : ;;   # USB / mic-less: nothing to overlay
  esac
  done_step micboard
fi

# 6b. XVF3800 LED/control tool.
#
#     The whole folder, never just the binary: xvf_host loads
#     libcommand_map.so from its own directory and dies with "cannot open
#     shared object file" if separated from it.
#
#     The ring is the satellite's only way to show it is listening, so a
#     card without this looks broken rather than merely plain — it sits in
#     the XMOS chip's own default display and never reacts to Domovoi.
if [ -d "$PAYDIR/xvf_host" ] && ! skip xvfhost; then
  info bootstrapping xvf-host
  mkdir -p /opt/xvf3800
  cp -r "$PAYDIR"/xvf_host/. /opt/xvf3800/
  chmod +x /opt/xvf3800/xvf_host 2>/dev/null ||     echo "WARN: no xvf_host binary in the payload — the LED ring stays dark"
  done_step xvfhost
fi

# 7. Units + sudoers + root helper.
if ! skip units; then
  info bootstrapping systemd-units
  install -m 0755 "$PAYDIR/system/domovoi-apply-payload" /usr/local/sbin/domovoi-apply-payload
  install -m 0755 "$PAYDIR/bootstrap/stage2.sh" \
    "$HOME_DIR/domovoi/satellite/scripts/stage2.sh"
  chown "$SAT_USER:$SAT_USER" "$HOME_DIR/domovoi/satellite/scripts/stage2.sh"
  for U in domovoi-satellite domovoi-provisioning domovoi-bootstrap; do
    sed -e "s|@USER@|$SAT_USER|g" -e "s|@HOME@|$HOME_DIR|g" \
      "$PAYDIR/system/$U.service" >"/etc/systemd/system/$U.service"
  done
  sed -e "s|@USER@|$SAT_USER|g" "$PAYDIR/system/sudoers" \
    >/etc/sudoers.d/domovoi-satellite
  chmod 0440 /etc/sudoers.d/domovoi-satellite
  systemctl daemon-reload
  # Satellite unit stays DISABLED until stage 2 finishes; provisioning +
  # bootstrap arm now.
  systemctl enable domovoi-provisioning domovoi-bootstrap
  done_step units
fi

# 8. Remove our own first-boot hook from the kernel cmdline.
#
#    MUST happen, and must happen last. `systemd.unit=kernel-command-line.target`
#    sends EVERY boot into a minimal target rather than multi-user.target;
#    left in place, boot 2 re-enters it, re-runs this script (every step
#    skips, so it exits 0 in seconds), and `systemd.run_success_action=reboot`
#    reboots again — a silent loop that never starts domovoi-provisioning,
#    so the setup portal never appears. Raspberry Pi Imager's firstrun does
#    the same cleanup for the same reason.
#
#    One line, no trailing blank line: a malformed cmdline can stop the Pi
#    booting entirely. Only OUR tokens go; modules-load=dwc2 on a USB-gadget
#    build must survive (provisioning removes that itself once adopted).
if ! skip cmdline; then
  info bootstrapping cmdline-cleanup
  for CMD in "$BOOT/cmdline.txt" /boot/firmware/cmdline.txt /boot/cmdline.txt; do
    [ -f "$CMD" ] || continue
    NEW="$(tr ' ' '
' <"$CMD"       | grep -v '^systemd\.run'       | grep -v '^systemd\.unit=kernel-command-line\.target$'       | tr '
' ' ' | sed -e 's/[[:space:]]\{1,\}/ /g' -e 's/^ //' -e 's/ $//')"
    [ -n "$NEW" ] && printf '%s
' "$NEW" >"$CMD"
    break
  done
  done_step cmdline
fi

# 9. USB gadget prerequisites are in config.txt already (the overlay wrote
#    them at prepare time). Done — hand off to boot 2.
info awaiting_provision stage1-done
echo "stage 1 complete; rebooting into adoption mode"
