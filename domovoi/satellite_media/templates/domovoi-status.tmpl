#!/bin/bash
# Domovoi satellite — the setup indicator.
#
# Setup runs across three programs that share nothing but the filesystem:
# firstrun.sh (bash, root), provisioning_mode.py (python, root) and
# stage2.sh (bash, root) — plus the client, which is neither. This script is
# the one place that knows what each phase looks and sounds like, so a phase
# can be re-tuned without touching four callers.
#
#   domovoi-status <state>
#   domovoi-status say-code <digits>
#
# Everything here is best-effort. A satellite with no LED ring, no speaker
# or an array that has not enumerated must still finish setting itself up —
# a dark ring is a disappointment, a failed provision is a returned unit.
#
# Placeholders: @HOME@, @ANNOUNCE@, @ALSA_CARD@, @ALSA_CONTROL@

set -u

STATE="${1:-}"
[ -n "$STATE" ] || exit 0

XVF=/opt/xvf3800/xvf_host
CLIPS="@HOME@/.domovoi/sounds/setup"
ANNOUNCE="@ANNOUNCE@"
# tmpfs on purpose: the "don't repeat yourself" memory below should last for
# one boot and no longer.
LAST=/run/domovoi-last-said
VENVPY="@HOME@/satellite-venv/bin/python"
# Setup runs before any of the client's audio config exists, so mpg123 would
# otherwise land on the ALSA default — the Pi's onboard jack or HDMI, not the
# USB array the customer's speaker is actually plugged into. Empty means the
# board shares card 0 and the default is right.
ALSA_CARD="@ALSA_CARD@"
ALSA_CONTROL="@ALSA_CONTROL@"
# Its own log. Every caller here discards this script's output — stage 1 and
# stage 2 into their own logs, the client into a subprocess it never reads —
# so without this there is no record anywhere of whether a clip played, only
# a customer reporting silence. That is the position this file put us in.
SLOG="@HOME@/.domovoi/setup-status.log"
note() { printf '%s %s
' "$(date -Is 2>/dev/null)" "$*" >>"$SLOG" 2>/dev/null || true; }

# The array renders effects itself; the host only picks one. Effect ids are
# leds.py's: 0=off 1=breath 2=rainbow 3=single 4=direction-of-arrival.
# led_brightness applies to breath and rainbow ONLY, so a state that should
# read as quiet has to be a dim colour rather than a dimmed one.
EFFECT=""
COLOR=""
SPEED=""
CLIP=""

case "$STATE" in
  # Boot 1. Minutes of disk and CPU with nothing on screen — the longest
  # silence in the whole flow, and the one people power-cycle through.
  setting-up)        EFFECT=1; COLOR=0xffb02e; SPEED=1 ;;

  # The soft AP is up and the portal is serving. The only moment a customer
  # is actively waiting for a cue from the device itself.
  ready-to-setup)    EFFECT=1; COLOR=0x00a8ff; SPEED=2; CLIP=ready ;;

  # A phone associated and asked for the portal page. Settling the breath to
  # solid acknowledges it without spending another sentence.
  phone-connected)   EFFECT=3; COLOR=0x00a8ff ;;

  # Credentials in, AP down, nmcli joining. The customer's phone drops the
  # setup network here, so this is where a silent device feels broken.
  joining)           EFFECT=1; COLOR=0xffb02e; SPEED=2; CLIP=joining ;;

  # A mistyped password is the likeliest failure in the flow.
  join-failed)       EFFECT=1; COLOR=0xe5484d; SPEED=2; CLIP=join_failed ;;

  # Joined, and the core answered the subnet sweep. Held briefly so success
  # is visible rather than inferred from the reboot that follows.
  on-network)        EFFECT=3; COLOR=0x30c46b; CLIP=on_network ;;

  # Boot 2 — reaching the core, installing what the offline payload missed.
  finishing)         EFFECT=1; COLOR=0xffb02e; SPEED=1 ;;

  # Connected and parked. The one state that needs a person at a DIFFERENT
  # device, so it gets a colour used nowhere else.
  awaiting-approval) EFFECT=1; COLOR=0xa855f7; SPEED=2 ;;

  # The mic is unplugged or has not enumerated. Today this kills the client
  # before it ever connects, so the dashboard cannot say anything at all —
  # the ring is the only channel left.
  no-microphone)     EFFECT=3; COLOR=0xe5484d; CLIP=no_microphone ;;

  # Connected to Wi-Fi or not, the core cannot be reached. Its own colour
  # because the alternative is what actually happened once: the ring kept
  # showing "awaiting approval" for an hour while the dashboard said
  # "waiting" and the client logged reconnects - three surfaces, none of
  # them saying "no network". The ring is the only one that still works
  # when the network is the broken thing, so it has to be the one that says
  # so. It says "look at me", not which half is at fault; the log does that.
  no-server)         EFFECT=1; COLOR=0xff6a00; SPEED=2 ;;

  # A startup step failed in a way retrying may not fix (no wake-word model,
  # unreadable config). Solid red and no speech: the ring is the only thing
  # left that can say anything, and there is nothing useful to tell someone
  # standing in front of it beyond "look at me".
  startup-failed)    EFFECT=3; COLOR=0xe5484d ;;

  off)               EFFECT=0 ;;
  say-code)          ;;
  *) exit 0 ;;
esac

# Root drives the array directly; the satellite user goes through the single
# sudoers entry for this binary. leds.py probes in exactly this order.
xvf() {
  [ -x "$XVF" ] || return 1
  "$XVF" "$@" >/dev/null 2>&1 && return 0
  sudo -n "$XVF" "$@" >/dev/null 2>&1
}

play() {
  [ "$ANNOUNCE" = "1" ] || { note "skip $1 (announce off)"; return 0; }
  if [ ! -f "$1" ]; then
    note "MISSING $1"
    return 0
  fi
  if ! command -v mpg123 >/dev/null 2>&1; then
    note "no mpg123 — cannot play $1"
    return 0
  fi
  if [ -n "$ALSA_CARD" ]; then
    # Force the master up for the duration of setup. The array's jack is
    # line-level and its PCM control starts wherever the firmware left it,
    # so an announcement can be inaudible on a speaker turned all the way
    # up. Nothing else is competing for the output yet, and the client
    # takes the volume back the moment it starts.
    amixer -c "$ALSA_CARD" sset "$ALSA_CONTROL" 100% >/dev/null 2>&1       || note "amixer -c $ALSA_CARD sset $ALSA_CONTROL 100% failed"
    if mpg123 -q -a "plughw:CARD=$ALSA_CARD" "$1" 2>>"$SLOG"; then
      note "played $1 on plughw:CARD=$ALSA_CARD"
      return 0
    fi
    note "plughw:CARD=$ALSA_CARD refused $1 — falling back to the ALSA default"
  fi
  # No card pinned, or the pinned one refused it. The default is very often
  # HDMI on a Pi, which is silence with a monitor attached — hence the log
  # line above, which is the only way to tell that apart from a clip that
  # never existed.
  if mpg123 -q "$1" 2>>"$SLOG"; then
    note "played $1 on the ALSA default"
  else
    note "FAILED to play $1 anywhere"
  fi
}

# ── the setup code, spoken digit by digit ─────────────────────────────────
#
# The code otherwise exists only on the portal page, and a customer who
# closed that tab has no way back to it. Hearing it FROM the device is also
# what proves the pending approval on the dashboard belongs to the unit in
# front of them.
if [ "$STATE" = "say-code" ]; then
  CODE="${2:-}"
  [ -n "$CODE" ] || exit 0
  play "$CLIPS/your_code_is.mp3"
  i=0
  while [ "$i" -lt "${#CODE}" ]; do
    D="${CODE:$i:1}"
    case "$D" in
      [0-9]) play "$CLIPS/digit_$D.mp3" ;;
    esac
    i=$((i + 1))
  done
  exit 0
fi

RING_OK=0
if [ -n "$COLOR" ]; then xvf led_color "$COLOR"; fi
if [ -n "$SPEED" ]; then xvf led_speed "$SPEED"; fi
if [ -n "$EFFECT" ]; then xvf led_effect "$EFFECT" && RING_OK=1; fi

# The 2-Mics HAT, when there is no XVF3800 to talk to. Its APA102 ring has
# no on-chip effects — every frame is clocked out over SPI by whoever owns
# the bus — so a phase can only be a SOLID colour here, and only once the
# venv and spidev exist. The XVF is lit from step 3b; this board is not.
if [ "$RING_OK" = "0" ] && [ -x "$VENVPY" ]; then
  ( cd "@HOME@/domovoi" && "$VENVPY" -m satellite.leds "$STATE" ) >/dev/null 2>&1 || true
fi

# Never say the same line twice running. Provisioning re-enters its states
# on every retry, and a device that repeats itself every thirty seconds is
# worse company than one that stays quiet.
if [ -n "$CLIP" ]; then
  PREV="$(cat "$LAST" 2>/dev/null || true)"
  if [ "$PREV" != "$CLIP" ]; then
    printf '%s' "$CLIP" >"$LAST" 2>/dev/null || true
    play "$CLIPS/$CLIP.mp3"
  fi
fi

exit 0
