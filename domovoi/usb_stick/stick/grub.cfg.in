# Domovoi room stick: the UEFI boot menu (domovoi/usb_stick/).
# Replaces Debian's /boot/grub/grub.cfg on the stick; Debian's signed
# shim and GRUB load it (it is configuration, not code, so Secure Boot is
# not involved). Nothing is erased by booting: the installer asks for ERASE
# first.
if [ x$feature_default_font_path = xy ] ; then
   font=unicode
else
   font=$prefix/font.pf2
fi
if loadfont $font ; then
  set gfxmode=800x600
  set gfxpayload=keep
  insmod efi_gop
  insmod efi_uga
  insmod video_bochs
  insmod video_cirrus
  insmod gfxterm
  insmod png
  terminal_output gfxterm
fi
set menu_color_normal=white/black
set menu_color_highlight=black/light-gray
set color_normal=light-gray/black
set timeout=10
set default=0

menuentry 'Make this computer the Domovoi room "@ROOM@" (asks before erasing)' {
    set background_color=black
    linux    /install.amd/vmlinuz vga=788 priority=high @KERNEL_EXTRA@--- quiet
    initrd   /install.amd/gtk/initrd.gz /domovoi/preseed.gz
}
menuentry 'The same, in text mode (if the screen above stays black)' {
    set background_color=black
    linux    /install.amd/vmlinuz vga=788 priority=high @KERNEL_EXTRA@--- quiet
    initrd   /install.amd/initrd.gz /domovoi/preseed.gz
}
menuentry 'Leave this computer as it is (start it normally)' {
    exit
}
