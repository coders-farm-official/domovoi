# TEST BUILDS ONLY (a stick made with debug=True): debug-room.sh, the
# journal and the first-boot log on the first serial port, so the QEMU kit
# can read what happened without a login. Never on a household's stick.
[Unit]
Description=Domovoi room stick (test build): journal to ttyS0
DefaultDependencies=no
After=systemd-journald.service

[Service]
ExecStart=/bin/sh /usr/local/lib/domovoi-stick/debug-room.sh
Restart=always

[Install]
WantedBy=sysinit.target
