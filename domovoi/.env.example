# Domovoi server configuration (.env)
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (same directory — next to config.py) and edit.
# EVERY setting the core reads is documented here; the uncommented entries
# are the library defaults for the common knobs, and every other setting
# appears commented out at its default value. Uncomment to override.
# Settings changed from the dashboard's gear menus are persisted into your
# `.env` by the server — entries appearing there over time is normal.

# Domovoi's Postgres publishes host port 6432 (docker-compose.yml) so it
# never collides with another Postgres on the default 5432.
DATABASE_URL=postgresql+asyncpg://domovoi:domovoi@localhost:6432/domovoi

# Test database — strictly separate from prod so pytest never nukes real
# data. The conftest auto-derives this by replacing the dbname in
# DATABASE_URL with `domovoi_test` if TEST_DATABASE_URL isn't set;
# uncomment + set explicitly only if your test DB lives elsewhere.
# Conftest also refuses to run if the resolved test URL doesn't end in
# `_test` — the safety belt against future contamination.
# TEST_DATABASE_URL=postgresql+asyncpg://domovoi:domovoi@localhost:6432/domovoi_test

# ─── Ollama ──────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
# QA / conversational — fast, cheap.
OLLAMA_MODEL=llama3.2:3b
# Tool-call routing — needs strong schema adherence.
# Fall back to llama3.2:3b if qwen2.5:14b isn't pulled (routing quality degrades).
OLLAMA_TOOL_MODEL=qwen2.5:14b
# Per-request read timeout (seconds). A stalled Ollama (model still
# loading, GPU wedged) must not pin a voice turn open forever — this
# bounds the wait so the turn fails gracefully instead.
# OLLAMA_TIMEOUT_SEC=120

# ─── Whisper STT (faster-whisper on CUDA) ───────────────────────────────
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ─── TTS engine router (edge → piper → system) ─────────────────────────
TTS_ENGINE=edge
TTS_EDGE_VOICE=en-US-AriaNeural
TTS_PIPER_VOICE=en_US-lessac-medium
TTS_SPEED=1.0
# Pre-populate the voice registry with the curated catalog of Edge +
# Piper voices (domovoi/voice_catalog.py) so they can be listed /
# sampled / switched by voice. Idempotent by name. The first boot after
# enabling renders every registered voice's greeting clips — slow + bandwidth
# heavy, one-time. Set false once you've curated the list (so voices you
# delete in the UI don't reappear on the next reboot).
SEED_VOICE_CATALOG=true
# Where uploaded Piper voice models (.onnx + .onnx.json) live — the same
# cache dir auto-downloaded HF Piper voices land in, so both sit side by
# side. Default ~/.domovoi/piper_voices.
# VOICE_MODELS_DIR=
# Where the Domovoi server renders per-voice greeting/canned clips and serves
# them from (/v1/sounds/). A generated runtime artifact dir (thousands of
# MP3s with the full catalog) — kept out of the repo. Default ~/.domovoi/sounds.
# SOUNDS_DIR=

# ─── Server internals ───────────────────────────────────────────────────
BOT_NAME=Domovoi
LOG_LEVEL=INFO
# How many recent turns a session keeps for conversational context.
SESSION_RECENT_TURNS_CAP=20
# WebSocket keep-alive ping cadence/timeout (seconds). A dead Pi socket
# surfaces as a disconnect within ~interval+timeout and evicts the stale
# session. Tighten (5/3) on rough WiFi; the ping traffic is negligible.
# WS_PING_INTERVAL_SEC=10
# WS_PING_TIMEOUT_SEC=5
# Timer/reminder watcher poll cadence (seconds).
# TIMER_WATCHER_INTERVAL_SEC=1
# Root of the git clone the server runs from. Auto-detected from the
# package location — override only for exotic layouts. Serves satellite/
# files for in-field Pi upgrades and powers the version label.
# REPO_DIR=

# ─── Satellites ─────────────────────────────────────────────────────────
# Pairing is trust-on-first-use: the first satellite to present a token
# for a room claims it; thereafter that room must present the matching
# token. A room that never paired still accepts a tokenless client —
# unless strict mode, which requires a token for EVERY room (hardening
# for an all-paired fleet).
# SATELLITE_PAIRING_STRICT=false
# After a pushed code upgrade + self-restart, how long the Pi gets to
# reconnect before its on-device watchdog rolls back to the pre-upgrade
# snapshot.
# SATELLITE_UPGRADE_RECONNECT_TIMEOUT_SEC=90

# ─── Custom wake words ───────────────────────────────────────────
# Trained openWakeWord models the server serves to satellites
# (/v1/wake-models/). Default ~/.domovoi/wake_models.
# WAKE_MODELS_DIR=
# Positive clips recorded on satellites, one subdir per wake-word slug;
# the trainer reads these as its positive set. Default ~/.domovoi/wake_clips.
# WAKE_CLIPS_DIR=
# The trainer worker is OFF by default: openWakeWord automatic training
# does not run on native Windows, so training shells out to an operator-
# supplied Linux pipeline (WSL2 / docker / Colab) — see
# scripts/wake_word/README.md. Enable only once that command is set up.
# WAKE_WORD_TRAINER_ENABLED=false
# Trainer queue poll cadence (seconds); training itself is a long shell-out.
# WAKE_WORD_TRAINER_LOOP_SEC=30
# Minimum positive clips before a wake word may be promoted to training.
# WAKE_WORD_MIN_CLIPS=15
# Auto-stop target for a satellite recording session. 0 = record until the
# user hits Stop (recommended — hard mics want hundreds of clips).
# WAKE_WORD_RECORD_TARGET_CLIPS=0
# Seconds of audio captured per recorded clip.
# WAKE_WORD_CLIP_SECONDS=2.0
# Linux train-command template; {clips_dir} {phrase} {slug} {out} are
# substituted before the command runs. Empty (default) disables training
# even when the trainer is enabled — queued words are marked failed with
# a runbook pointer.
# WAKE_WORD_TRAIN_COMMAND=

# ─── MPD (lazy per-room provisioning) ──────────────────────────────────
# An MPD daemon per voice-satellite room keeps queues / current track /
# volume independent. The Domovoi server spawns containers ON DEMAND when
# a new satellite first connects to /v1/stream/{room_id}; ports are
# allocated and persisted to the `mpd_rooms` table so they survive a
# server restart. No teardown on disconnect — Pis drop WiFi.
#
# MPD_HOST is where MPD's control port lives from the Domovoi server's POV
# (always localhost — containers run on the same host). MPD_HTTP_BASE is
# the URL prefix the Pi uses to reach its room's HTTP stream — must be
# reachable FROM THE PI, so use Domovoi's LAN hostname (e.g.
# http://my-domovoi.local), not localhost (resolves to the Pi itself).
MPD_HOST=localhost
MPD_HTTP_BASE=http://my-domovoi.local

# Provisioning knobs — bases sit clear of MPD's conventional 6600/8001
# ranges so Domovoi's per-room daemons coexist with any other MPD fleet.
# First room gets 6650/8050, second 6651/8051, etc.
# MPD_PROVISION_TIMEOUT_SEC is how long we wait for a freshly-spawned
# container's control port; tens of seconds is normal on first boot
# because MPD scans the music library before answering.
# MPD_PORT_BASE_CONTROL=6650
# MPD_PORT_BASE_HTTP=8050
# MPD_PROVISION_TIMEOUT_SEC=30
# Image tag the provisioner builds + runs, and the container/volume name
# prefixes it appends the room id to (room "kitchen" → domovoi-mpd-kitchen).
# Kept stable so existing containers restart instead of recreating.
# MPD_IMAGE_TAG=domovoi-mpd:latest
# MPD_CONTAINER_PREFIX=domovoi-mpd-
# MPD_VOLUME_PREFIX=domovoi-mpd-
# Volume every (re)started MPD is pinned to. The satellite's hardware
# mixer is the single volume control, so MPD stays at 100 to avoid
# double attenuation. Change only if you deliberately want MPD to be
# the attenuator.
# MPD_STARTUP_VOLUME=100
# Fallback (seconds) for the music_ready handshake — if the Pi never
# reports its stream consumer is primed, playback resumes anyway after
# this long.
# MUSIC_PREPARE_FALLBACK_SEC=5

# ─── Music library ──────────────────────────────────────────────────────
# Host path; default is your home Music folder (~/Music). The per-room MPD
# containers bind-mount it read-only as /music. Media acquisitions
# fulfilled by an installed provider plugin land here, then trigger
# `mpd update` to index them. Use forward slashes on Windows (Docker
# Compose requirement), e.g. MUSIC_DIR=C:/Users/you/Music
# MUSIC_DIR=
# Album-art cache for the browser player, keyed by track id — extracted
# from the files on demand and self-healing, safe to delete. Default
# ~/.domovoi/cover_art.
# COVER_ART_DIR=

# ─── Library enricher ────────────────────────────────────────────────────
# After the indexer populates library_tracks with mutagen + filename-parse
# metadata, the enricher tries to identify each file via Chromaprint
# fingerprint → AcoustID → MusicBrainz (canonical title/artist/album/MB-ID),
# falling through to shazamio for tracks AcoustID's catalog doesn't cover.
# Disable to skip the network calls entirely; the core service works fine
# with just the indexer's metadata.
LIBRARY_ENRICHER_ENABLED=true
# Free key from https://acoustid.org/api-key (~30 seconds to register).
# Leave empty to skip AcoustID — shazamio still runs as the sole identifier.
# ACOUSTID_API_KEY=
# Polite delay between identification calls. AcoustID's free tier asks
# for "be reasonable"; 1/sec is well under any threshold and gets a 764-
# track library through in ~13 minutes on the first run.
# LIBRARY_ENRICHER_DELAY_SEC=1.0
# Minimum AcoustID confidence (0–1). Below this we discard the match and
# fall through to Shazam — defends against confident-but-wrong matches
# on low-quality fingerprints.
# LIBRARY_ENRICHER_ACOUSTID_MIN_SCORE=0.7

# ─── Spoken audio (Podcasts + Audiobooks) ───────────────────────────────
# Host paths, mirroring the music dir; both are bind-mounted read-only
# into every per-room MPD. Defaults ~/.domovoi/podcasts and
# ~/.domovoi/audiobooks.
# PODCASTS_DIR=
# AUDIOBOOKS_DIR=
# Feed poller: walks subscriptions, records new episodes, downloads the
# newest N, LRU-evicts past each show's keep_n. OFF by default until a
# download toolchain (provider plugin) is configured.
# PODCAST_FEED_POLLER_ENABLED=false
# PODCAST_FEED_POLLER_INTERVAL_SEC=1800
# Default newest-N episodes kept downloaded per show (per-subscription
# keep_n overrides).
# PODCAST_KEEP_N=5
# Audiobook indexer — startup sweep + slow poll for dropped-in .m4b /
# per-chapter folders; a manual reindex endpoint covers the interactive case.
# AUDIOBOOK_INDEXER_ENABLED=true
# AUDIOBOOK_INDEXER_INTERVAL_SEC=300

# ─── Offline office suite (Documents / Spreadsheets / Drawings) ─────────
# Root of user document storage — one flat dir; the three web pages are
# filtered views over it. Default ~/Documents.
# DOCUMENTS_DIR=
# Editor engines are docker-compose sidecars, OFF by default. To enable:
# set the flag(s), set BOTH JWT secrets (the engines refuse blank secrets;
# generate with `openssl rand -hex 32`), set the LAN-routable URLs below,
# then `docker compose up -d onlyoffice collabora`.
# ONLYOFFICE_ENABLED=false
# COLLABORA_ENABLED=false
# ONLYOFFICE_JWT_SECRET=
# COLLABORA_JWT_SECRET=
# Browser-reachable editor base URLs and the URL the containers use to
# call back into the dashboard. All three MUST be LAN hostnames, never
# localhost — the iframe loads assets from them AND the container reaches
# back for file fetch/save.
# ONLYOFFICE_BASE_URL=http://my-domovoi.local:6381
# COLLABORA_BASE_URL=http://my-domovoi.local:6980
# OFFICE_CALLBACK_BASE=http://my-domovoi.local:6369
# Stale edit-lock sweeper: a crashed editor stops heartbeating; after
# this long its lock is cleared so the other engine's button un-greys.
# DOCUMENT_LOCK_STALE_SEC=900
# DOCUMENT_LOCK_SWEEPER_INTERVAL_SEC=60

# ─── Media-acquisition queue + playback sweeper ─────────────────────────
# The queue is core's seam for USER-requested media (voice "add X to my
# library", dashboard adds, save-to-device): requests wait in Postgres
# until an installed provider plugin claims and fulfills them; with no
# provider installed they sit pending with a friendly message. Core
# never initiates acquisitions on its own.
# How many failed fulfillment attempts before a queued request is
# marked failed for good.
# ACQUISITION_MAX_ATTEMPTS=3
# Core sweeper cadence (stale now-playing stamps, queue hygiene,
# natural-end stop pushes to the Pi).
# PLAYBACK_SWEEPER_INTERVAL_SEC=5

# ─── Two-way drop-in (live room-to-room audio) ──────────────────────────
# DROPIN_ENABLED=true
# 'auto' opens the target room's mic immediately; 'confirm' makes the
# target say yes first.
# DROPIN_ACCEPT_MODE=auto
# Auto-hang-up after this many seconds of two-way silence.
# DROPIN_SILENCE_TIMEOUT_SEC=20
# Echo gate for calls between NEARBY rooms: relay frames quieter than
# this (dBFS) aren't forwarded — silences bounced echo and lets the
# silence timeout actually fire. Lower = more permissive; -120 ≈ off.
# DROPIN_RELAY_GATE_DBFS=-55

# ─── Play history ───────────────────────────────────────────────────────
# "Recently played" rows older than this are pruned; <= 0 keeps forever.
# MEDIA_PLAYS_RETENTION_DAYS=90
# MEDIA_PLAYS_PRUNER_INTERVAL_SEC=21600

# ─── Voice profiling (VoiceProfileHandler) ──────────────────────
# Presence-tier thresholds for "how aggressively should I prompt for
# identity when I hear an unknown voice?" Drawn from time since *any*
# known person was last heard:
#   < SOFT  → low    (don't prompt — someone known was just here)
#   < HARD  → medium (mild follow-up if it comes up naturally)
#   ≥ HARD  → high   (direct ask: "I don't recognize you, who am I
#                     talking to?")
VOICE_PROFILE_SOFT_TIER_SEC=3600
VOICE_PROFILE_HARD_TIER_SEC=14400

# Cosine-similarity floor for embedding match. Resemblyzer's authors
# recommend ~0.75; raise toward 0.80 if cousins / siblings collide,
# lower toward 0.70 if the same person gets rejected on a cold or
# distant mic.
# VOICE_PROFILE_MATCH_THRESHOLD=0.75

# Minimum utterance length (seconds) before we even try to embed.
# Resemblyzer needs ~1 s of voiced audio for a stable vector.
# VOICE_PROFILE_MIN_UTTERANCE_SEC=1.0

# Drift handling: after N consecutive confident-but-near-threshold
# matches for the same person (within MARGIN above the floor), a fresh
# sample is appended so the reference tracks the voice as it shifts
# (colds, mic distance, age).
# VOICE_PROFILE_DRIFT_NEAR_THRESHOLD_MARGIN=0.05
# VOICE_PROFILE_DRIFT_REENROLL_AFTER=3

# Third-party intro flow ("this is Alex"): how long the expectation
# stays parked, how similar unknown-voice samples must be to pool into
# one cluster, the classifier confidence needed to ask "was that Alex?",
# and the minimum pooled audio before classifying.
# THIRD_PARTY_INTRO_TTL_SEC=600
# THIRD_PARTY_CLUSTER_MERGE_THRESHOLD=0.7
# THIRD_PARTY_CLASSIFIER_THRESHOLD=0.6
# THIRD_PARTY_MIN_CLUSTER_AUDIO_SEC=1.2

# ─── Implicit memory extraction ──────────────────────────────────
# Background worker mines conversation logs of known people for long-term
# facts, written as PENDING memories the user confirms by voice before
# they activate. Disable to opt the household out entirely.
# MEMORY_EXTRACTOR_ENABLED=true
# MEMORY_EXTRACTOR_LOOP_SEC=60
# New conversation rows needed since the last pass before re-running.
# MEMORY_EXTRACTOR_THRESHOLD_TURNS=20
# Minimum LLM confidence to write a pending memory (quality filter —
# everything written still awaits user confirmation).
# MEMORY_EXTRACTOR_MIN_CONFIDENCE=0.6
# Cooldown before re-offering a pending memory nobody answered.
# MEMORY_EXTRACTOR_OFFER_COOLDOWN_SEC=86400
# Max conversation turns pulled per extraction pass.
# MEMORY_EXTRACTOR_MAX_TURNS_PER_PASS=80

# ─── Radio streaming + passive song detection ───────────────────────────
# Two halves: a background sampler that captures favorited stations and
# IDs songs (local fingerprints first, then online), and the voice/web
# streaming surface. Both gated so an unconfigured install burns no CPU.
# RADIO_SAMPLER_ENABLED=true
# Per-station sample cadence default (per-favorite overrides).
# RADIO_DEFAULT_SAMPLE_INTERVAL_SEC=180
# RADIO_SAMPLER_INNER_LOOP_SEC=30
# Suppress duplicate (station, artist, title) detections inside this window.
# RADIO_DEDUP_WINDOW_SEC=1800
# ffmpeg wall-clock limit per sample grab (connect + ~15 s capture).
# RADIO_FFMPEG_TIMEOUT_SEC=20
# Concurrent station grabs (one ffmpeg subprocess each).
# RADIO_SAMPLE_CONCURRENCY=5
# ICY metadata poller — reads StreamTitle headers off the stream; orders
# of magnitude cheaper than sampling, which remains the fallback for
# stations without ICY metadata.
# RADIO_ICY_POLLER_ENABLED=true
# RADIO_ICY_POLL_INTERVAL_SEC=30
# RADIO_ICY_CONCURRENCY=10
# RADIO_ICY_REQUEST_TIMEOUT_SEC=6
# Your market, used to filter the FCC FM import and disambiguate bare
# frequency commands ("play 97.5 fm"). State is the 2-letter code.
# RADIO_MARKET_CITY=
# RADIO_MARKET_STATE=
# Trigger the FCC FM station import once on startup (~30 s against the
# FCC); most installs use the dashboard's Import button instead.
# RADIO_FCC_IMPORT_ON_BOOT=false
# RTL-SDR dongle (over-the-air FM). Off until the hardware + WinUSB
# driver are present; absence is probed and logged, never fatal.
# RADIO_SDR_ENABLED=false
# RADIO_SDR_DEVICE_INDEX=0
# Port the rtl_fm→ffmpeg pipeline serves its HTTP audio stream on.
# RADIO_SDR_HTTP_PORT=8090
# Base URL (scheme+host) MPD uses to reach that stream. With Docker
# Desktop the container's localhost is NOT the host — use the same LAN
# hostname as MPD_HTTP_BASE.
# RADIO_SDR_STREAM_BASE=http://127.0.0.1

# ─── News ────────────────────────────────────────────────────────
# Per-person topics + house briefings from RSS, summarized by the local
# Ollama. Master switch gates the daily background fetch and the worker.
# NEWS_ENABLED=true
# Hour of day (0–23 local) the daily fetch runs.
# NEWS_FETCH_HOUR=5
# Items older than this are swept (favorites never auto-delete).
# NEWS_RETENTION_DAYS=90
# Gates ONLY the daily background fetch of per-person topic feeds (the
# general briefing rides NEWS_ENABLED). Verbal fetches always confirm
# per request regardless.
# NEWS_AUTO_FETCH=false
# Stories returned per ask/scope (voice-editable).
# NEWS_ITEMS_PER_ASK=3
# City/region for the LOCAL scope of the general briefing; empty drops
# the local block.
# NEWS_LOCATION=
# Feed-discovery caps per free-form topic (SearxNG search → RSS probe).
# NEWS_DISCOVERY_MAX_FEEDS=4
# NEWS_DISCOVERY_MAX_PROBE=8
# Worker wake cadence; the actual fetch fires when the configured hour
# ticks over.
# NEWS_FETCHER_LOOP_SEC=900

# ─── Conversational chat mode (Letta) ───────────────────────────────────
# Wake-word-triggered open-mic conversation backed by a self-hosted Letta
# agent on the local Ollama — distinct from command mode, whose latency
# is untouched. OFF by default; enabling assumes the letta compose
# service is up and the models below are pulled in Ollama
# (`ollama pull nomic-embed-text`).
# CHAT_MODE_ENABLED=false
# Open-mic silence timeout — bounds an abandoned chat so the satellite
# returns to the wake-word gate instead of streaming room tone forever.
# CHAT_SILENCE_TIMEOUT_SEC=30
# Letta runs in its OWN container with its OWN bundled Postgres — never
# point it at the Domovoi database.
# LETTA_BASE_URL=http://localhost:6283
# Must match the compose service's LETTA_SERVER_PASSWORD. LAN-only.
# LETTA_TOKEN=domovoi-local
# LLM handle for chat turns + bridged tool calls (schema adherence
# matters, so it mirrors the tool-routing model).
# LETTA_MODEL=ollama/qwen2.5:14b
# Embeddings are REQUIRED on self-hosted Letta.
# LETTA_EMBEDDING_MODEL=ollama/nomic-embed-text:latest
# How a Letta tool (inside Letta's container) calls back into the core —
# the host is host.docker.internal from in there, not localhost.
# LETTA_TOOL_CALLBACK_URL=http://host.docker.internal:6370

# ─── SearxNG (DoubleCheckHandler) ───────────────────────────────────────
SEARXNG_URL=http://localhost:6888

# ─── ConnectivityProbe ──────────────────────────────────────────────────
CONNECTIVITY_PROBE_TARGET=1.1.1.1:443
CONNECTIVITY_PROBE_INTERVAL_SEC=30
CONNECTIVITY_PROBE_TIMEOUT_SEC=2

# ─── Testing / dev ──────────────────────────────────────────────────────
# Set to true in test conftest to bypass CUDA/Ollama/TTS deps.
USE_STUBS=false
