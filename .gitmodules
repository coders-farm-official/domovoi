	path = android/native/sherpa-onnx/deps/kaldi_decoder
	url = https://github.com/k2-fsa/kaldi-decoder
[submodule "android/native/sherpa-onnx/deps/kaldi_native_fbank"]
	path = android/native/sherpa-onnx/deps/kaldi_native_fbank
	url = https://github.com/csukuangfj/kaldi-native-fbank
[submodule "android/native/sherpa-onnx/deps/kaldifst"]
	path = android/native/sherpa-onnx/deps/kaldifst
