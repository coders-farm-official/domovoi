[Unit]
Description=Domovoi core voice service
After=domovoi-db.service ollama.service
Requires=domovoi-db.service
Wants=ollama.service

[Service]
Type=simple
User=domovoi
WorkingDirectory=/opt/domovoi
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/domovoi
ExecStart=/opt/domovoi/.venv/bin/python -m domovoi.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
# Sandboxing (docs/LINUX_HOST.md, "Sandboxing the units"). Writable: the
# checkout and its venv (pulls, plugin installs, .env), the service user's
# home (~/.domovoi, the model caches, the default media folders) and the
# usual mount points for media disks; every other user's home is hidden.
#
# This unit is deliberately looser than domovoi-web and domovoi-db: the
# dashboard's Restart, and with it the update unit (domovoi-update.service),
# runs `sudo -n systemctl ...` from this process (domovoi/self_restart.py).
# sudo needs its set-uid bit honoured, so the unit must never end up with
# the no_new_privs flag. systemd sets that flag not only for
# NoNewPrivileges=yes but, for a unit that runs as an unprivileged User=
# (no CAP_SYS_ADMIN), for every option it enforces with seccomp
# (systemd.exec(5), NoNewPrivileges=): DynamicUser, LockPersonality,
# MemoryDenyWriteExecute, PrivateDevices, ProtectClock, ProtectHostname,
# ProtectKernelLogs, ProtectKernelModules, ProtectKernelTunables,
# RestrictAddressFamilies, RestrictNamespaces, RestrictRealtime,
# RestrictSUIDSGID, SystemCallArchitectures, SystemCallFilter and
# SystemCallLog. None of them is set here: under any one of them sudo
# refuses ("The no new privileges flag is set") and the Restart button
# reports no sudoers grant. What stays is the mount-namespace part, which
# implies nothing: a read-only system, a private /tmp, hidden homes,
# read-only control groups and a 0027 umask.
# Also left out, for the hardware: ProtectClock and PrivateDevices hide
# GPU and SDR devices, MemoryDenyWriteExecute breaks the speech stack's
# JIT compilers (numba, torch, onnxruntime).
UMask=0027
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/domovoi
# Media disks and removable cards (a missing path is skipped).
ReadWritePaths=-/mnt -/media -/run/media -/srv
ProtectHome=tmpfs
BindPaths=/home/domovoi
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
