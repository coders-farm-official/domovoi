[Unit]
# Installed by scripts/linux/provision.sh and scripts/linux/apply-update.sh
# (docs/LINUX_HOST.md, "The file-cache trim"); started every 2 minutes by
# domovoi-cache-trim.timer. Inside WSL it hands old file cache back to
# Windows above a limit; on a dedicated Linux box it only records the
# cache, unless /etc/domovoi/cache-trim.conf switches it on.
Description=Domovoi file-cache trim
Documentation=file:///opt/domovoi/docs/LINUX_HOST.md

[Service]
Type=oneshot
# The root-owned copy, never the checkout's (the service user can edit that).
# -I -S: no environment, no site-packages, no current folder on the path.
ExecStart=/usr/bin/python3 -I -S /usr/local/lib/domovoi-cache-trim/cache-trim.py
TimeoutStartSec=5min
Nice=10
IOSchedulingClass=idle
# /var/lib/domovoi-cache-trim, 0755: the status file the core reads.
StateDirectory=domovoi-cache-trim
StateDirectoryMode=0755
# Its lines are notice-level, and nothing below notice reaches the journal:
# a run with nothing to do (every 2 minutes) leaves no trace, systemd's own
# "Starting/Finished" lines included; a trim, or a problem, does.
SyslogLevel=notice
LogLevelMax=notice
# It reads /proc and /etc/domovoi, asks systemd about domovoi-update, and
# writes the root cgroup's memory.reclaim (or /proc/sys/vm/drop_caches) and
# its status file; nothing else. No ProtectControlGroups=: that would make
# /sys/fs/cgroup, and so memory.reclaim, read-only.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
