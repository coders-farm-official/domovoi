[Unit]
Description=Domovoi web dashboard
# Not After=domovoi-core.service: the core is Type=notify, "activating"
# until its startup is done, and the dashboard must be up meanwhile, and
# while the core is stuck, to say so and to restart it.
After=domovoi-db.service
Wants=domovoi-db.service domovoi-core.service

[Service]
Type=simple
User=domovoi
WorkingDirectory=/opt/domovoi
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/domovoi
ExecStart=/opt/domovoi/.venv/bin/python -m web.backend.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# Sandboxing (docs/LINUX_HOST.md, "Sandboxing the units"): the full set,
# NoNewPrivileges and no capabilities included, since the dashboard
# process never runs sudo (the Restart button goes through the core, whose
# unit is looser for exactly that reason). Restarting a core that doesn't
# answer needs no privilege either: the dashboard signals the core's main
# process, which runs as the same user, and the core unit's Restart=
# starts it again (web/backend/core_restart.py).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/domovoi
# Media disks and removable cards (a missing path is skipped).
ReadWritePaths=-/mnt -/media -/run/media -/srv
ProtectHome=tmpfs
BindPaths=/home/domovoi
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
